    "notice.body.first" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app is not affiliated with, endorsed by, or sponsored by Nintendo, Game Freak, Creatures Inc., or The Pokemon Company."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本アプリは Nintendo、Game Freak、Creatures Inc.、The Pokemon Company とは公式の提携、承認、保証関係にありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본 애플리케이션은 Nintendo, Game Freak, Creatures Inc., 또는 The Pokemon Company와 어떠한 공식적 제휴, 승인, 보증 관계도 없습니다."
          }
        }
      }
    },
    "notice.body.second" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokemon and related characters belong to their respective owners. This app is a fan project developed for non-commercial purposes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokemon および関連キャラクターの著作権は各権利者に帰属します。本アプリは非営利目的のファンプロジェクトです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokemon 및 그 관련 캐릭터의 저작권은 해당 소유자에게 귀속됩니다. 본 앱은 팬 프로젝트로서 순수한 비상업적 목적 하에 개발되었습니다."
          }
        }
      }
    },
    "notice.body.third" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All resources used by this app are independently recreated unofficial resources and may be shared and used freely."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本アプリのリソースは公式素材ではなく、独自に再構成した非公式リソースです。自由に共有および利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱에 사용된 모든 리소스(아이콘, 데이터, 그래픽 등)는 The Pokemon Company의 공식 자료를 사용하지 않고, 독자적으로 재구성 및 제작된 비공식 리소스입니다. 자유로운 공유 및 사용이 가능합니다."
          }
        }
      }
    },
    "notice.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app is unofficial"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリは公式サービスではありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 공식 서비스가 아닙니다"
          }
        }
      }
    },
